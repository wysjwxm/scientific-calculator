# ============================================================================
# 科学计算器 —— 手工验收请求集
#
# 用法：启动服务（java -jar target/scientific-calculator-0.0.1-SNAPSHOT.jar）后，
#       在 IDE 里逐块点 ▶ 执行，或整文件运行。
# 基线：{{base}} = http://localhost:8080（端口取自 application.yaml:15；
#       注意该端口没有任何测试使用 —— HTTP 测试走随机端口，所以 8080 属生产配置）
#
# 【预期标注口径】—— 三档，别混着读：
#   [钉住]      HTTP 层测试断言过（CalculatorEndToEndTest / CalculatorControllerTest）
#   [领域层钉]  领域层或应用层测试断言过；**HTTP 层的序列化形态没有钉住**
#   [待观察]    无任何断言覆盖。第一次执行以实测为准，不要拿它判对错
#
# 为什么大多数函数只有 [领域层钉]：HTTP 层只钉了 sin(30)=0.5 一个函数值。
# 其余函数的值断言都在领域层 —— 以 FunctionRegistryTest 为主，个别在 EvalTest / PrecisionTest；
# 而 acosh 的合法入参值**从未被任何测试断言过**（见 5.12，那里标的是 [待观察]）。
#
# 错误响应统一为 {code, message, position, timestamp, path}；
#   position 只在语法类错误里出现（@JsonInclude(NON_NULL)），其余情况**键不存在**。
# ============================================================================

@base = http://localhost:8080


# ----------------------------------------------------------------------------
# 0. 健康检查
# ----------------------------------------------------------------------------

# 预期 [钉住] 200，响应体含 "status":"UP"；uptimeMs 是数字
### 0.1 健康检查
GET {{base}}/health


# 预期 [钉住·同机制] 404 + NO_HANDLER（统一错误结构；whitelabel 已关，不会是 HTML 错误页）
#   被钉住的具体路径是 GET /api/v1/nope（见 10.1）；本条是同一机制的另一条路径，未单独断言
### 0.2 健康检查带错前缀（验证 404 的统一形态）
GET {{base}}/api/v1/calculator/health


# ----------------------------------------------------------------------------
# 1. 验收标准（spec §14 中本 MVP 可执行的部分 + docs/mvp-and-roadmap.md §四）
# ----------------------------------------------------------------------------

# 预期 [钉住] 200，"result":1.5，angleUnit 为 "DEGREE"（未传 angleUnit → 取缺省）
# 这是 spec §14 第 3 条验收项，也是整个验收的核心一条
### 1.1 【验收】1 + 2 * sin(30) ^ 2  →  1.5
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "1 + 2 * sin(30) ^ 2"}


### 预期 [钉住] 200，"result":0.3（精确路径：不是 0.30000000000000004）
### 1.2 【验收】0.1 + 0.2  →  0.3
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "0.1+0.2"}


# 预期 [钉住] 200，"result":0.5
### 1.3 角度制下的 sin(30)
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "sin(30)"}


# ----------------------------------------------------------------------------
# 2. 优先级与结合性三规则（README 语法速查的同一组例子）
# ----------------------------------------------------------------------------

# 预期 [钉住] 200，"result":-4 —— 幂的优先级高于一元负号：-(2^2)，不是 (-2)^2
### 2.1 -2^2  →  -4
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "-2^2"}


# 预期 [钉住] 200，"result":512 —— 幂是右结合：2^(3^2)，不是 (2^3)^2
### 2.2 2^3^2  →  512
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "2^3^2"}


# 预期 [领域层钉] 200，"result":7（HTTP 层未钉此例）
### 2.3 3!+1  →  7
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "3!+1"}


# ----------------------------------------------------------------------------
# 3. 四则、括号、取模、一元正号
# ----------------------------------------------------------------------------

# 预期 [钉住] 200，"result":7，"resultType":"DECIMAL"
# 响应体字段：{expression, result, resultType, angleUnit}
### 3.1 1+2*3  →  7
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "1+2*3"}


# 预期 [领域层钉] 200，"result":9
### 3.2 (1+2)*3  →  9
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "(1+2)*3"}


# 预期 [领域层钉] 200，"result":1（% 是中缀取模；取模的除数为 0 见 8.26）
### 3.3 7%3  →  1
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "7%3"}


# 预期 [领域层钉] 200，"result":5（前缀一元 + 是合法算子）
### 3.4 +5  →  5
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "+5"}


# ----------------------------------------------------------------------------
# 4. 两条数值路径（精确 BigDecimal / 浮点 double）与结果的线上形态
# ----------------------------------------------------------------------------

# 预期 [钉住] 200，"result":0.3 —— 精确路径，不出现二进制浮点噪声
### 4.1 精确路径：0.1 + 0.2
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "0.1+0.2"}


# 预期 [领域层钉] 200，"result":0.333…（**34 位小数**，取自 calculator.division-precision=34；
#                 HTTP 层未断言位数的线上形态）
### 4.2 除法：1/3  →  34 位小数
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "1/3"}


# 预期 [钉住] 200，"result":100（**不是** 1E+2）—— 精确路径的整数结果写成普通十进制。
#   问题已关闭：CalcNumberSerializer 走 toPlainString()，这里的线上形态被两条测试钉住 ——
#   单元级 CalcNumberSerializerTest.integralExactResultsDoNotUseScientificNotation（断言 {"value":100}）
#   与真实 HTTP 栈 CalculatorEndToEndTest.integralExactResultIsWrittenAsPlainDecimalOnTheRealStack
#   （断言含 "result":100，且 doesNotContain("1E+2")）。
### 4.3 整数结果的线上形态：2*50  →  100
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "2*50"}


# 预期 [领域层钉] 200，"result":4.0（**不是** 4）—— 浮点路径走 writeNumber(double)，写出的是 double 的形态。
#   值由领域层钉住：ExpressionEvaluatorTest.dispatchesToFunctions 断言 num("sqrt(16)") == 4.0；
#   线上形态由 CalcNumberSerializerTest.floatingPathIsWrittenAsDouble 直连序列化器钉住（{"value":4.0}）。
#   HTTP 层没有为这一例写过断言 —— 所以是 [领域层钉]，不是 [钉住]。
### 4.4 浮点路径的整数形态：sqrt(16)  →  4.0
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "sqrt(16)"}


# 预期 [领域层钉] 200，"resultType":"FLOATING"（该取值在 HTTP 层未被断言，只有 "DECIMAL" 被钉）
### 4.5 浮点路径的 resultType 取值：sin(30)
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "sin(30)"}


# ----------------------------------------------------------------------------
# 5. 函数逐个（28 个：一元 23 + 二元 5）
#    除 5.1 是 [钉住] 外，其余绝大多数是 [领域层钉]（HTTP 层没有为它们写过断言）；
#    少数几条标 [待观察]，别混读
# ----------------------------------------------------------------------------

# ---- 三角函数（角度敏感；入参是角度，按 angleUnit 换算）----

# 预期 [钉住] 200，"result":0.5
### 5.1 sin(30)  角度制
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "sin(30)"}

# 预期 [领域层钉] 200，"result":0.5
### 5.2 cos(60)
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "cos(60)"}

# 预期 [领域层钉] 200，"result":1.0
### 5.3 tan(45)
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "tan(45)"}

# 预期 [待观察] tan(90)：**不会报错** —— 浮点里 π/2 不可精确表示，所以不存在「tan(90) 是无穷」
#   这种判定，实际会得到一个很大的**有限值**（量级我不写死，以你实测为准）。
#   这是数值近似的已知表现，不是缺陷。
### 5.4 tan(90)  角度制的数值近似
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "tan(90)"}


# ---- 反三角函数（入参是比值、不换算；**返回值**是角度，按 angleUnit 换算）----

# 预期 [领域层钉] 200，"result":30.0
### 5.5 asin(0.5)  角度制
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "asin(0.5)"}

# 预期 [领域层钉] 200，"result":60.0
### 5.6 acos(0.5)  角度制
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "acos(0.5)"}

# 预期 [领域层钉] 200，"result":45.0
### 5.7 atan(1)  角度制
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "atan(1)"}


# ---- 双曲函数（角度无关，两制同值）----

