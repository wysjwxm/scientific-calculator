# ----------------------------------------------------------------------------
# 6. 角度单位
# ----------------------------------------------------------------------------

# 预期 [钉住] 200，$.angleUnit = "RADIAN"（数值本身未被钉住）
### 6.1 显式指定 RADIAN
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "sin(30)", "angleUnit": "RADIAN"}


# 预期 [领域层钉] 200，"result":-0.988031624092862（30 弧度 ≈ 1718.87°，所以是负值）
### 6.2 RADIAN 下 sin(30) 的取值
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "sin(30)", "angleUnit": "RADIAN"}


# 预期 [钉住] 200，angleUnit 字段**在场且为 null**（不是键缺失）—— 非三角表达式不涉及角度
### 6.3 非三角表达式：angleUnit 为 null
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "1+2"}


# 预期 [待观察] 400 INVALID_REQUEST —— 枚举里没有 GRADIANS（只有 DEGREE / RADIAN）
#   代码路径：Jackson 反序列化枚举失败 → HttpMessageNotReadableException → 400
### 6.4 非法的 angleUnit 取值
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "sin(30)", "angleUnit": "GRADIANS"}


# ----------------------------------------------------------------------------
# 7. 请求级变量（本期没有变量存储，变量只在单次请求内可见）
# ----------------------------------------------------------------------------

# 预期 [钉住] 200，"result":14
### 7.1 变量参与计算：x*2 且 x=7
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "x*2", "variables": {"x": 7}}


# 预期 [钉住] 400，code=INVALID_REQUEST（消息里含变量名；HTTP 层未断言消息文本）——
#   请求级变量名落在**禁用集合**（函数名 ∪ 保留常量名）内即被拒，永远不会走到求值、更算不成 sin(3)。
#   「覆盖内建含义」是**修正前**的行为，已不成立：spec :372 与 docs/mvp-and-roadmap.md:104
#   现在都写明「键落在禁用集合内 → 400 INVALID_REQUEST」。
#   实现在 CalculationCommand 的紧凑构造器（保留名校验），HTTP 层的断言见
#   CalculatorControllerTest.rejectsVariableWhoseNameIsReserved（400 + INVALID_REQUEST，仅 MockMvc）。
### 7.2 保留名被拒：sin(pi) 且 pi=3
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "sin(pi)", "variables": {"pi": 3}}


# 预期 [待观察] 200，值为 5.0（该表达式无断言；变量作为单值参与求值）
### 7.3 变量单独成项：x 且 x=5
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "x", "variables": {"x": 5}}


# ----------------------------------------------------------------------------
# 8. 错误矩阵
# ----------------------------------------------------------------------------

# ---- 8.1–8.4 解析错误（400 PARSE_ERROR，position 给出出错位置）----
#   8.1 是 [钉住]；8.2–8.4 只有领域层的位置断言 —— position 的线上值与领域层一致，
#   但 HTTP 层没有为它们写过断言。

# 预期 [钉住] 400，code=PARSE_ERROR，position=2，path=/api/v1/calculator/calculate
### 8.1 缺操作数：1+
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "1+"}


# 预期 [钉住] 400，code=PARSE_ERROR（position 未被钉住）
### 8.2 非法字符：1$2
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "1$2"}


# 预期 [领域层钉] 400 PARSE_ERROR，position=4
### 8.3 多余的运算符：1 + * 2
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "1 + * 2"}


# 预期 [领域层钉] 400 PARSE_ERROR，position=4
### 8.4 括号不匹配：(1+2
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "(1+2"}


# 预期 [领域层钉] 400 PARSE_ERROR，position=5
### 8.5 多余的右括号：(1+2))
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "(1+2))"}


# 预期 [领域层钉] 400 PARSE_ERROR，position=6
#   注意：spec §7.6 的样例写的是 position=7、消息里带"第 7 个字符处"；
#   实现把位置放在独立字段、消息里不含位置，且该场景实测为 6。以实测为准。
### 8.6 函数括号未闭合：sin(30
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "sin(30"}


# 预期 [领域层钉] 400 PARSE_ERROR，position=7
### 8.7 二元函数缺参：max(1,2
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "max(1,2"}


# 预期 [领域层钉] 400 PARSE_ERROR，position=6
### 8.8 参数为空：max(1,)
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

{"expression": "max(1,)"}


# 预期 [领域层钉] 400 PARSE_ERROR，position=4
### 8.9 非法字符：1 + @
POST {{base}}/api/v1/calculator/calculate
Content-Type: application/json

